# BranDive SocialFlow AI - Environment Configuration Example
# Copy this file to .env and configure local values.

# Database Configuration (SQLite for local dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# Application Environment
NODE_ENV="development"
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Security & Encryption (Replace with high-entropy keys in production)
JWT_SECRET="brandive-socialflow-jwt-super-secret-key-min-32-chars"
# 32-byte AES-256-GCM encryption key formatted as a 64-character hex string
TOKEN_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# AI Provider Configuration (Options: GEMINI, OPENAI, MOCK)
AI_PROVIDER="GEMINI"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Meta (Facebook Pages & Instagram Professional)
# Note: When left empty, SocialFlow AI automatically activates High-Fidelity Demo Mode
META_APP_ID=""
META_APP_SECRET=""
META_REDIRECT_URI="http://localhost:3000/api/v1/integrations/meta/callback"

# LinkedIn (Marketing Developer Platform)
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_REDIRECT_URI="http://localhost:3000/api/v1/integrations/linkedin/callback"

# YouTube Data API v3 (Google Cloud OAuth 2.0)
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REDIRECT_URI="http://localhost:3000/api/v1/integrations/youtube/callback"
